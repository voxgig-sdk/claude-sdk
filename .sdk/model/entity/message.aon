\"example\":\"invalid_request_error\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"description\":\"Object type\",\"enum\":[\"error\"],\"example\":\"error\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"security\":[{\"ApiKeyAuth\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"API key for authentication. Obtain your API key from https://platform.claude.com/settings/keys\",\"in\":\"header\",\"name\":\"x-api-key\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
